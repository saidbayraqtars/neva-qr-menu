APP_NAME="Neva-QR Menu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

# --- YEREL (php artisan serve) ---
# Siteye HER ZAMAN APP_URL ile ayni host'tan girin. "serve" 127.0.0.1:8000 dinler;
# 127.0.0.1 ile localhost farkli host sayilir, karisirsa oturum/CSRF (419) bozulur.
APP_URL=http://127.0.0.1:8000
NEVA_ROOT_DOMAIN=localhost

# --- WILDCARD ALT DOMAIN (Laravel Herd/Valet) ---
# APP_URL=http://nevaqr.test
# NEVA_ROOT_DOMAIN=nevaqr.test

# --- URETIM (Ubuntu 24.04 VPS + Cloudflare) ---
# Kurulum: deploy/kurulum.sh  ·  Dagitim: deploy/guncelle.sh  ·  Detay: docs/URETIM.md
# APP_URL=https://nevaqr.com
# NEVA_ROOT_DOMAIN=nevaqr.com
# NOT: SESSION_DOMAIN'i ".nevaqr.com" YAPMAYIN. Kiraci menuleri kullanici
# icerigi render eder; cookie tum alt domainlere gonderilirse oradaki bir XSS
# panel oturumunu calabilir. Menuler public oldugu icin paylasima gerek yok.

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MVP: SQLite. Uretimde DB_CONNECTION=pgsql onerilir.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=neva_qr
# DB_USERNAME=neva
# DB_PASSWORD=

# OneDrive/Dropbox klasoru altinda SQLite kilitlenebilir; oturum+onbellek dosya tabanli.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# SESSION_DOMAIN tanimsiz: cookie hangi host'tan geldiyse ona baglanir.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Yayina alma isi (DNS + otomatik dogrulama) ve e-postalar kuyrukta calisir.
# Uretimde MUTLAKA "database" olsun + `php artisan queue:work` servisi calissin.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Yuklemeler ozel diskte tutulur ve /gorsel/... ucundan yetkiyle servis edilir.
NEVA_UPLOAD_DISK=uploads

# --- CANLI MENU ONBELLEGI ---
# Panelde degisiklik olunca menu_version artar -> ANINDA yansir.
# Bu TTL yalnizca ust sinirdir (varsayilan 2 saat = 7200 sn).
NEVA_MENU_CACHE=true
NEVA_MENU_CACHE_TTL=7200
NEVA_MENU_HTTP_MAX_AGE=7200

# --- ALT DOMAIN YAYINA ALMA ---
# wildcard : *.nevaqr.com DNS'te tanimli (varsayilan, ek islem yok)
# cloudflare: her kiraci icin CNAME kaydi API ile acilir
# manual   : DNS kaydi elle acilir
NEVA_DNS_DRIVER=wildcard
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# NEVA_DNS_TARGET=nevaqr.com
# CLOUDFLARE_PROXIED=true

# Onay sonrasi otomatik HTTP dogrulamasi (200 + isletme adi sayfada geciyor mu)
NEVA_PUBLISH_VERIFY=true

# --- ODEME: HAVALE / EFT (online odeme Faz-2) ---
NEVA_PAYMENT_MODE=bank_transfer
NEVA_BANK_ACCOUNT_NAME="Neva Yazilim"
NEVA_BANK_NAME="Ziraat Bankasi"
NEVA_BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"
NEVA_PAYMENT_REF_PREFIX=NQR

# --- SEO ---
NEVA_INDEX_TENANTS=true
# NEVA_TWITTER=@nevaqr

# Organization > sameAs: DOGRULANMIS profilleri girin. Var olmayan/bos hesap
# yazmak, hic yazmamaktan kotudur — cozulmeyen sameAs guven sinyalini dusurur.
# NEVA_SEO_INSTAGRAM=https://www.instagram.com/nevaqr
# NEVA_SEO_LINKEDIN=https://www.linkedin.com/company/nevaqr
# NEVA_SEO_YOUTUBE=
# NEVA_SEO_X=

# Yayina almadan once calistirin: eksik SEO ayarlarini satir satir soyler.
#   php artisan neva:onkontrol --seo

# --- HUKUKI METINLER / KVKK ---
# Sirket kunyesi ZORUNLU (KVKK m.10). Bos birakilan alan hukuki sayfalarda
# kirmizi "tanimlanmadi" rozetiyle gorunur. Yayina almadan once doldurun.
NEVA_LEGAL_TITLE="Neva Yazilim"
NEVA_LEGAL_ADDRESS=
NEVA_LEGAL_TAX_OFFICE=
NEVA_LEGAL_TAX_NO=
# NEVA_LEGAL_MERSIS=
# NEVA_LEGAL_KEP=
# NEVA_LEGAL_PHONE=
# NEVA_LEGAL_EMAIL=          # bos birakilirsa NEVA_SUPPORT_EMAIL kullanilir
NEVA_LEGAL_EFFECTIVE=2026-09-02

# Saklama sureleri (gun). `neva:veri-temizle` gunluk calisir; 0 = hic silme.
# Bu degerler ayni zamanda KVKK metnindeki tabloda gorunur - tek kaynak.
NEVA_RETENTION_CONTACT=730          # iletisim formu kaydi
NEVA_RETENTION_CONTACT_IP=90        # formdaki IP bu surede maskelenir
NEVA_RETENTION_AUDIT=730            # denetim kaydi
NEVA_RETENTION_VISITS=395           # goruntulenme sayaclari (kisisel veri degil)
NEVA_RETENTION_MEMBERSHIP=365       # reddedilmis uyelik talepleri
NEVA_COOKIE_BANNER=true

# --- E-POSTA ---
# Uretimde gercek SMTP girin: hesap acilis linki, havale talimati, onay
# bildirimleri ve destek mesaji bildirimleri bu kanaldan gider.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="destek@nevaqr.com"
MAIL_FROM_NAME="${APP_NAME}"
NEVA_SUPPORT_EMAIL="destek@nevaqr.com"

# Online odeme (Faz-2 — is buyuyunce). MVP'de havale yeterli.
# CASHIER_CURRENCY=try
# IYZICO_API_KEY=
# IYZICO_SECRET=
