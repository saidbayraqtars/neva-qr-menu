APP_NAME="Neva-QR Menu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

# --- YEREL (php artisan serve) ---
# Siteye HER ZAMAN APP_URL ile ayni host'tan girin. "serve" 127.0.0.1:8000 dinler;
# 127.0.0.1 ile localhost farkli host sayilir, karisirsa oturum/CSRF (419) bozulur.
APP_URL=http://127.0.0.1:8000
NEVA_ROOT_DOMAIN=localhost

# --- WILDCARD ALT DOMAIN (Laravel Herd/Valet) ---
# APP_URL=http://neva-qr.test
# NEVA_ROOT_DOMAIN=neva-qr.test
# SESSION_DOMAIN=.neva-qr.test   (alt domainler arasi tek oturum)

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MVP: SQLite. Uretimde DB_CONNECTION=pgsql onerilir.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=neva_qr
# DB_USERNAME=neva
# DB_PASSWORD=

# OneDrive/Dropbox klasoru altinda SQLite kilitlenebilir; oturum+onbellek dosya tabanli.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# SESSION_DOMAIN tanimsiz: cookie hangi host'tan geldiyse ona baglanir.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

NEVA_UPLOAD_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="destek@neva-qr.com"
MAIL_FROM_NAME="${APP_NAME}"

# Odeme (Faz-2). MVP'de manuel/trial abonelik yeterli.
# CASHIER_CURRENCY=try
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
