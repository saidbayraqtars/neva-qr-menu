APP_NAME="Neva-QR Menu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

# --- YEREL (php artisan serve) ---
# Siteye HER ZAMAN APP_URL ile ayni host'tan girin. "serve" 127.0.0.1:8000 dinler;
# 127.0.0.1 ile localhost farkli host sayilir, karisirsa oturum/CSRF (419) bozulur.
APP_URL=http://127.0.0.1:8000
NEVA_ROOT_DOMAIN=localhost

# --- WILDCARD ALT DOMAIN (Laravel Herd/Valet) ---
# APP_URL=http://nevaqr.test
# NEVA_ROOT_DOMAIN=nevaqr.test

# --- URETIM ---
# APP_URL=https://nevaqr.com
# NEVA_ROOT_DOMAIN=nevaqr.com
# NOT: SESSION_DOMAIN'i ".nevaqr.com" YAPMAYIN. Kiraci menuleri kullanici
# icerigi render eder; cookie tum alt domainlere gonderilirse oradaki bir XSS
# panel oturumunu calabilir. Menuler public oldugu icin paylasima gerek yok.

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MVP: SQLite. Uretimde DB_CONNECTION=pgsql onerilir.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=neva_qr
# DB_USERNAME=neva
# DB_PASSWORD=

# OneDrive/Dropbox klasoru altinda SQLite kilitlenebilir; oturum+onbellek dosya tabanli.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# SESSION_DOMAIN tanimsiz: cookie hangi host'tan geldiyse ona baglanir.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Yayina alma isi (DNS + otomatik dogrulama) ve e-postalar kuyrukta calisir.
# Uretimde MUTLAKA "database" olsun + `php artisan queue:work` servisi calissin.
QUEUE_CONNECTION=sync
CACHE_STORE=file

NEVA_UPLOAD_DISK=public

# --- CANLI MENU ONBELLEGI ---
# Panelde degisiklik olunca menu_version artar -> ANINDA yansir.
# Bu TTL yalnizca ust sinirdir (varsayilan 2 saat = 7200 sn).
NEVA_MENU_CACHE=true
NEVA_MENU_CACHE_TTL=7200
NEVA_MENU_HTTP_MAX_AGE=7200

# --- ALT DOMAIN YAYINA ALMA ---
# wildcard : *.nevaqr.com DNS'te tanimli (varsayilan, ek islem yok)
# cloudflare: her kiraci icin CNAME kaydi API ile acilir
# manual   : DNS kaydi elle acilir
NEVA_DNS_DRIVER=wildcard
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# NEVA_DNS_TARGET=nevaqr.com
# CLOUDFLARE_PROXIED=true

# Onay sonrasi otomatik HTTP dogrulamasi (200 + isletme adi sayfada geciyor mu)
NEVA_PUBLISH_VERIFY=true

# --- ODEME: HAVALE / EFT (online odeme Faz-2) ---
NEVA_PAYMENT_MODE=bank_transfer
NEVA_BANK_ACCOUNT_NAME="Neva Yazilim"
NEVA_BANK_NAME="Ziraat Bankasi"
NEVA_BANK_IBAN="TR00 0000 0000 0000 0000 0000 00"
NEVA_PAYMENT_REF_PREFIX=NQR

# --- SEO ---
NEVA_INDEX_TENANTS=true
# NEVA_TWITTER=@nevaqr

# --- E-POSTA ---
# Uretimde gercek SMTP girin: hesap acilis linki, havale talimati, onay
# bildirimleri ve destek mesaji bildirimleri bu kanaldan gider.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="destek@nevaqr.com"
MAIL_FROM_NAME="${APP_NAME}"
NEVA_SUPPORT_EMAIL="destek@nevaqr.com"

# Online odeme (Faz-2 — is buyuyunce). MVP'de havale yeterli.
# CASHIER_CURRENCY=try
# IYZICO_API_KEY=
# IYZICO_SECRET=
